+    #[inline(always)]
+    fn calendar_cached(&self, b: &[u8]) -> Option<i64> {
+        let p = b.as_ptr();
+        unsafe {
+            let d0 = (*p.add(8)).wrapping_sub(b'0');
+            let d1 = (*p.add(9)).wrapping_sub(b'0');
+            let d = (d0 as u32 * 10 + d1 as u32) as usize;
+            if ((non_digit_bits(d0) | non_digit_bits(d1)) & 0xF0) == 0 && d < 32 {
