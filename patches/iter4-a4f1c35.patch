+                    let m0 = (*p.add(23)).wrapping_sub(b'0');
+                    let m1 = (*p.add(24)).wrapping_sub(b'0');
+                    if ((non_digit_bits(h0) | non_digit_bits(h1) | non_digit_bits(m0) | non_digit_bits(m1)) & 0xF0)
