+                    let h1 = (*p.add(12)).wrapping_sub(b'0');
+                    let n0 = (*p.add(14)).wrapping_sub(b'0');
+                    let n1 = (*p.add(15)).wrapping_sub(b'0');
+                    let s0 = (*p.add(17)).wrapping_sub(b'0');
+                    let s1 = (*p.add(18)).wrapping_sub(b'0');
