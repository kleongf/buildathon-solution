+                        let mi = (*p.add(14)).wrapping_sub(b'0') as i64 * 10
+                            + (*p.add(15)).wrapping_sub(b'0') as i64;
+                        let s = (*p.add(17)).wrapping_sub(b'0') as i64 * 10
+                            + (*p.add(18)).wrapping_sub(b'0') as i64;
